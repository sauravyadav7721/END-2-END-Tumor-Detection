# ML workflow folders (root-anchored so backend/models/ source code stays tracked)
# Contents are ignored; .gitkeep keeps the empty folder in the repo.
/logs/*
!/logs/.gitkeep
/checkpoints/*
!/checkpoints/.gitkeep
/models/*
!/models/.gitkeep
# Experiments: notebooks are tracked, generated outputs are not
/experiments/*
!/experiments/.gitkeep
!/experiments/*.ipynb

# Runtime logs written by the backend
backend/logs/
